{
  "name": "Doodle Jump",
  "description": "Doodle Jump C Engine for KaiOS",
  "version": "1.0.0",
  "launch_path": "/index.html",
  "type": "web",
  "origin": "app://doodlejump.kaios",
  "fullscreen": "true",
  "precompile": [
    "/lib/phaser-3.24.1.min.js",
    "/kaios_asmjs/doodle_engine.asm.js",
    "/kaios_asmjs/doodle_engine.js"
  ],
  "icons": {
    "56": "/icon56.png",
    "112": "/icon112.png"
  },
  "developer": {
    "name": "Doodle Jump Dev",
    "url": "https://ai.studio"
  },
  "locales": {
    "en-US": {
      "name": "Doodle Jump",
      "description": "Doodle Jump for KaiOS"
    }
  },
  "default_locale": "en-US",
  "orientation": ["portrait-primary"]
}
